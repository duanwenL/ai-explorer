<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example</groupId>
        <artifactId>ai-explorer</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>ai-explorer-rag</artifactId>
    <name>ai-explorer-rag</name>
    <description>AI 探索实验室：Java 混合检索实验</description>
    <dependencies>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
        <dependency><groupId>org.springframework.ai</groupId><artifactId>spring-ai-starter-model-openai</artifactId></dependency>
        <dependency><groupId>org.commonmark</groupId><artifactId>commonmark</artifactId></dependency>
        <dependency><groupId>org.springframework.ai</groupId><artifactId>spring-ai-tika-document-reader</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration><systemPropertyVariables>
                    <rag.browser-node>${maven.multiModuleProjectDirectory}/target/frontend/node/node</rag.browser-node>
                </systemPropertyVariables></configuration>
            </plugin>
            <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
            <!-- 页面作为静态资源随 JAR 提供，npm 仅负责开发依赖、测试和 lint。 -->
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId></plugin>
            <plugin><groupId>com.github.eirslett</groupId><artifactId>frontend-maven-plugin</artifactId></plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>browser-tests</id>
            <properties><rag.browser-test>true</rag.browser-test></properties>
            <build><plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration><systemPropertyVariables>
                        <rag.browser-test>true</rag.browser-test>
                    </systemPropertyVariables></configuration>
                </plugin>
                <plugin>
                    <groupId>com.github.eirslett</groupId>
                    <artifactId>frontend-maven-plugin</artifactId>
                    <executions><execution>
                        <id>install-test-browser</id>
                        <phase>generate-test-resources</phase>
                        <goals><goal>npm</goal></goals>
                        <configuration><arguments>exec -- playwright install chromium</arguments></configuration>
                    </execution></executions>
                </plugin>
            </plugins></build>
        </profile>
    </profiles>
</project>
