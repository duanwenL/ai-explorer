# 环境变量示例，没有真实密钥。Spring Boot 不自动读取 .env。
# 默认加载已忽略的 config/application-local.yml，环境变量优先。
EMBEDDING_BASE_URL=https://api.openhubs.com/v1
EMBEDDING_PATH=/embeddings
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_API_KEY=
RAG_EMBEDDING_BATCH_SIZE=10
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_PORT=8081
QDRANT_URL=http://127.0.0.1:6333
# 项目改名保留原集合及文档 ID；改模型/维度请换新集合。
QDRANT_COLLECTION=simple_rag_hybrid_text-embedding-v4_1024
