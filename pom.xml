<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>
    <groupId>com.example</groupId>
    <artifactId>ai-explorer</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ai-explorer</name>
    <description>AI 探索实验室：统一 Maven 构建入口</description>
    <modules>
        <module>rag</module>
        <module>agent</module>
    </modules>
    <properties>
        <java.version>21</java.version>
        <spring-ai.version>1.1.8</spring-ai.version>
        <commonmark.version>0.24.0</commonmark.version>
        <frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>
        <frontend.node.version>v22.19.0</frontend.node.version>
        <frontend.npm.version>10.9.3</frontend.npm.version>
        <frontend.skip>false</frontend.skip>
        <skipTests>false</skipTests>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.commonmark</groupId>
                <artifactId>commonmark</artifactId>
                <version>${commonmark.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.5.0</version>
                    <executions><execution>
                        <id>require-module-javascript-manifests</id>
                        <phase>validate</phase>
                        <goals><goal>enforce</goal></goals>
                        <configuration><rules><requireFilesExist><files>
                            <file>${project.basedir}/package.json</file>
                            <file>${project.basedir}/package-lock.json</file>
                        </files></requireFilesExist></rules></configuration>
                    </execution></executions>
                </plugin>
                <!-- Maven 下载并使用项目私有 Node/npm，不修改系统 Node。 -->
                <plugin>
                    <groupId>com.github.eirslett</groupId>
                    <artifactId>frontend-maven-plugin</artifactId>
                    <version>${frontend-maven-plugin.version}</version>
                    <configuration>
                        <workingDirectory>${project.basedir}</workingDirectory>
                        <installDirectory>${maven.multiModuleProjectDirectory}/target/frontend</installDirectory>
                        <nodeVersion>${frontend.node.version}</nodeVersion>
                        <npmVersion>${frontend.npm.version}</npmVersion>
                        <skip>${frontend.skip}</skip>
                    </configuration>
                    <executions>
                        <execution>
                            <id>install-node-and-npm</id>
                            <phase>initialize</phase>
                            <goals><goal>install-node-and-npm</goal></goals>
                        </execution>
                        <execution>
                            <id>install-locked-javascript-dependencies</id>
                            <phase>generate-resources</phase>
                            <goals><goal>npm</goal></goals>
                            <configuration><arguments>ci --no-audit --no-fund</arguments></configuration>
                        </execution>
                        <execution>
                            <id>javascript-tests</id>
                            <phase>test</phase>
                            <goals><goal>npm</goal></goals>
                            <configuration>
                                <arguments>run test</arguments>
                                <skip>${skipTests}</skip>
                            </configuration>
                        </execution>
                        <execution>
                            <id>javascript-lint</id>
                            <phase>verify</phase>
                            <goals><goal>npm</goal></goals>
                            <configuration><arguments>run lint</arguments></configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
